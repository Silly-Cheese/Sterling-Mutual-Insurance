rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function staffDoc(){ return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isActiveStaff(){
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().data.status == "active";
    }
    function hasPermission(permission){
      return isActiveStaff()
        && ("*" in staffDoc().data.permissions || permission in staffDoc().data.permissions);
    }
    function ownsCustomer(customerId){
      return signedIn()
        && exists(/databases/$(database)/documents/customers/$(customerId))
        && get(/databases/$(database)/documents/customers/$(customerId)).data.authUid == request.auth.uid;
    }


    // Customer and provider medical intake is strictly separate from claim settlement.
    // The Northstar app uses another Firebase project; no cross-project reads are trusted.
    function isApprovedMedicalProvider() {
      return signedIn()
        && exists(/databases/$(database)/documents/providerAccounts/$(request.auth.uid))
        && get(/databases/$(database)/documents/providerAccounts/$(request.auth.uid)).data.authUid == request.auth.uid
        && get(/databases/$(database)/documents/providerAccounts/$(request.auth.uid)).data.status == "active";
    }

    function medicalRequestCreateValid() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly([
          "schemaVersion","submitterUid","submitterRole","customerId","policyId","policyNumber",
          "patientName","providerName","invoiceNumber","sourceInvoiceId","serviceDate",
          "expenseCategory","amount","notes","sourceSystem","status","createdAt","updatedAt"
        ])
        && d.keys().hasAll([
          "schemaVersion","submitterUid","submitterRole","customerId","policyId","policyNumber",
          "patientName","providerName","invoiceNumber","sourceInvoiceId","serviceDate",
          "expenseCategory","amount","notes","sourceSystem","status","createdAt","updatedAt"
        ])
        && d.schemaVersion == 1
        && d.submitterUid == request.auth.uid
        && d.submitterRole in ["customer","provider"]
        && d.status == "submitted"
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.customerId is string && d.policyId is string && d.policyNumber is string && d.policyNumber.size() <= 80
        && d.patientName is string && d.patientName.size() >= 2 && d.patientName.size() <= 160
        && d.providerName is string && d.providerName.size() >= 2 && d.providerName.size() <= 160
        && d.invoiceNumber is string && d.invoiceNumber.size() >= 1 && d.invoiceNumber.size() <= 100
        && d.sourceInvoiceId is string && d.sourceInvoiceId.size() <= 100
        && d.serviceDate is string && d.serviceDate.size() == 10
        && d.expenseCategory in ["hospital","physician","medication","imaging","procedure","therapy","other"]
        && d.amount is number && d.amount > 0 && d.amount <= 1000000
        && d.notes is string && d.notes.size() <= 1000
        && d.sourceSystem in ["northstar","manual"]
        && (
          (
            d.submitterRole == "customer"
            && ownsCustomer(d.customerId)
            && (
              (d.policyId == "" && d.policyNumber == "")
              || (
                exists(/databases/$(database)/documents/policies/$(d.policyId))
                && get(/databases/$(database)/documents/policies/$(d.policyId)).data.customerId == d.customerId
                && get(/databases/$(database)/documents/policies/$(d.policyId)).data.policyNumber == d.policyNumber
              )
            )
          )
          || (
            d.submitterRole == "provider"
            && isApprovedMedicalProvider()
            && d.customerId == ""
            && d.policyId == ""
            && d.providerName == get(/databases/$(database)/documents/providerAccounts/$(request.auth.uid)).data.organizationName
          )
        );
    }

    function medicalReviewUpdateValid(requestId) {
      let d = request.resource.data;
      return (
          hasPermission("claim.update")
          || hasPermission("claim.createForCustomer")
          || hasPermission("claim.decide")
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","customerId","policyId","policyNumber","claimId","claimNumber",
          "reviewNote","reviewedBy","reviewedAt","updatedAt"
        ])
        && d.status in ["needs_info","declined","converted"]
        && resource.data.status in ["submitted","needs_info"]
        && d.reviewedBy == request.auth.uid
        && d.reviewedAt == request.time
        && d.updatedAt == request.time
        && d.get("reviewNote","") is string
        && d.get("reviewNote","").size() <= 1000
        && (
          d.status != "converted"
          || (
            hasPermission("claim.createForCustomer")
            && d.claimId is string && d.claimId.size() > 0
            && d.claimNumber is string && d.claimNumber.size() > 0
            && d.customerId is string && d.customerId.size() > 0
            && d.policyId is string && d.policyId.size() > 0
            && getAfter(/databases/$(database)/documents/claims/$(d.claimId)).data.medicalRequestId == requestId
            && getAfter(/databases/$(database)/documents/claims/$(d.claimId)).data.customerId == d.customerId
            && getAfter(/databases/$(database)/documents/claims/$(d.claimId)).data.policyId == d.policyId
          )
        );
    }

    // Self-service customer onboarding: an authenticated customer may create exactly
    // one new prospect record, with its private portal link and account state in one
    // atomic batch. Existing customer and policy records cannot be claimed here.
    function canCreateOwnCustomerRecord(customerId) {
      let d = request.resource.data;
      let account = get(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
      let portalAfter = getAfter(/databases/$(database)/documents/customerAccounts/$(request.auth.uid)).data;
      let accountAfter = getAfter(/databases/$(database)/documents/accounts/$(request.auth.uid)).data;
      return signedIn()
        && account.accountType == "customer"
        && account.accessStatus == "pending"
        && !exists(/databases/$(database)/documents/customerAccounts/$(request.auth.uid))
        && d.keys().hasOnly([
          "firstName","lastName","displayName","email","phone","authUid",
          "portalEmail","portalStatus","status","source","createdBy","createdAt","updatedAt"
        ])
        && d.keys().hasAll([
          "firstName","lastName","displayName","email","phone","authUid",
          "portalEmail","portalStatus","status","source","createdBy","createdAt","updatedAt"
        ])
        && d.authUid == request.auth.uid
        && d.createdBy == request.auth.uid
        && d.firstName is string && d.firstName.size() >= 2 && d.firstName.size() <= 80
        && d.lastName is string && d.lastName.size() >= 2 && d.lastName.size() <= 80
        && d.displayName == d.firstName + " " + d.lastName
        && d.phone is string && d.phone.size() <= 30
        && d.email == request.auth.token.email.lower()
        && d.portalEmail == d.email
        && d.portalStatus == "active"
        && d.status == "prospect"
        && d.source == "self_service"
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && portalAfter.customerId == customerId
        && portalAfter.authUid == request.auth.uid
        && accountAfter.customerId == customerId
        && accountAfter.accessStatus == "customer";
    }


    function canCreateOwnCustomerPortal(uid) {
      let d = request.resource.data;
      let account = get(/databases/$(database)/documents/accounts/$(uid)).data;
      let customerAfter = getAfter(/databases/$(database)/documents/customers/$(d.customerId)).data;
      let accountAfter = getAfter(/databases/$(database)/documents/accounts/$(uid)).data;
      return signedIn()
        && request.auth.uid == uid
        && account.accountType == "customer"
        && account.accessStatus == "pending"
        && d.keys().hasOnly([
          "authUid","customerId","email","displayName","status","createdBy","createdAt"
        ])
        && d.keys().hasAll([
          "authUid","customerId","email","displayName","status","createdBy","createdAt"
        ])
        && d.authUid == uid
        && d.createdBy == uid
        && d.status == "active"
        && d.email == request.auth.token.email.lower()
        && d.createdAt == request.time
        && d.customerId is string && d.customerId.size() > 0 && d.customerId.size() <= 128
        && customerAfter.authUid == uid
        && customerAfter.source == "self_service"
        && customerAfter.createdAt == request.time
        && customerAfter.displayName == d.displayName
        && accountAfter.accessStatus == "customer"
        && accountAfter.customerId == d.customerId;
    }


    function canFinishOwnCustomerSignup(uid) {
      let d = request.resource.data;
      let portalAfter = getAfter(/databases/$(database)/documents/customerAccounts/$(uid)).data;
      let customerAfter = getAfter(/databases/$(database)/documents/customers/$(d.customerId)).data;
      return signedIn()
        && request.auth.uid == uid
        && resource.data.accountType == "customer"
        && resource.data.accessStatus == "pending"
        && d.diff(resource.data).affectedKeys().hasOnly([
          "accessStatus","customerId","linkedAt","linkedBy"
        ])
        && d.accessStatus == "customer"
        && d.customerId is string && d.customerId.size() > 0 && d.customerId.size() <= 128
        && d.linkedBy == uid
        && d.linkedAt == request.time
        && portalAfter.customerId == d.customerId
        && portalAfter.createdBy == uid
        && portalAfter.createdAt == request.time
        && customerAfter.authUid == uid
        && customerAfter.createdAt == request.time;
    }


    function bootstrapPath(){ return /databases/$(database)/documents/system/bootstrap; }
    function bootstrapStaffPath(){ return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function isBootstrapCreateForSelf(){
      return signedIn()
        && !exists(bootstrapPath())
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.employeeId == "SMI-000001"
        && request.resource.data.role == "founder"
        && request.resource.data.department == "executive"
        && request.resource.data.title == "Founder / Chief Executive Officer"
        && request.resource.data.status == "active"
        && request.resource.data.permissions.size() == 1
        && request.resource.data.permissions[0] == "*"
        && getAfter(bootstrapPath()).data.initialized == true
        && getAfter(bootstrapPath()).data.initializedBy == request.auth.uid;
    }

    match /system/{docId} {
      allow read: if hasPermission("system.read")
                  || (docId == "bootstrap" && signedIn());
      allow create: if docId == "bootstrap"
                    && signedIn()
                    && !exists(bootstrapPath())
                    && request.resource.data.initialized == true
                    && request.resource.data.initializedBy == request.auth.uid
                    && request.resource.data.state == "initialized"
                    && request.resource.data.bootstrapVersion == 1
                    && getAfter(bootstrapStaffPath()).data.authUid == request.auth.uid
                    && getAfter(bootstrapStaffPath()).data.role == "founder"
                    && getAfter(bootstrapStaffPath()).data.employeeId == "SMI-000001";
      allow update, delete: if false;
    }

    match /staff/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid)
                  || (isActiveStaff() && hasPermission("staff.read"));
      allow create: if (
                      uid == request.auth.uid
                      && isBootstrapCreateForSelf()
                    )
                    || (
                      hasPermission("staff.manage")
                      && request.resource.data.role != "founder"
                    );
      allow update: if (
                      hasPermission("staff.manage")
                      && resource.data.role != "founder"
                      && request.resource.data.role != "founder"
                    )
                    || (
                      signedIn()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "availability","availabilityUpdatedAt"
                      ])
                    );
      allow delete: if false;
    }

    match /accounts/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid)
                  || hasPermission("staff.read")
                  || hasPermission("staff.manage")
                  || (hasPermission("customer.account.manage") && resource.data.get("accountType","") == "customer");
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && exists(bootstrapPath())
                    && get(bootstrapPath()).data.initialized == true
                    && request.resource.data.authUid == request.auth.uid
                    && request.resource.data.accessStatus == "pending";
      allow update: if canFinishOwnCustomerSignup(uid)
                    || hasPermission("staff.manage")
                    || (
                      hasPermission("customer.account.manage")
                      && resource.data.get("accountType","") == "customer"
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "accessStatus","customerId","linkedAt","linkedBy"
                      ])
                      && request.resource.data.accessStatus == "customer"
                      && request.resource.data.linkedBy == request.auth.uid
                      && getAfter(/databases/$(database)/documents/customerAccounts/$(uid)).data.customerId == request.resource.data.customerId
                    );
      allow delete: if false;
    }

    match /customerAccounts/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid)
                  || hasPermission("customer.account.manage");
      allow create: if canCreateOwnCustomerPortal(uid)
                    || (
                      hasPermission("customer.account.manage")
                      && request.resource.data.authUid == uid
                      && request.resource.data.status == "active"
                    );
      allow update: if hasPermission("customer.account.manage");
      allow delete: if false;
    }


    match /providerAccounts/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid)
                  || hasPermission("staff.manage");
      allow create: if hasPermission("staff.manage")
                    && request.resource.data.authUid == uid
                    && exists(/databases/$(database)/documents/accounts/$(uid))
                    && get(/databases/$(database)/documents/accounts/$(uid)).data.accountType == "provider"
                    && request.resource.data.status == "active"
                    && request.resource.data.organizationName is string
                    && request.resource.data.organizationName.size() >= 2
                    && request.resource.data.organizationName.size() <= 160;
      allow update: if hasPermission("staff.manage")
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","updatedAt","updatedBy"])
                    && request.resource.data.authUid == uid
                    && request.resource.data.status in ["active","suspended"];
      allow delete: if false;
    }

    // Public users can only create immutable intake records, never official claims,
    // payment records, settlement values or coverage decisions.
    match /medicalClaimRequests/{requestId} {
      // Firestore list queries must constrain submitterUid == signed-in uid.
      // Owner-only history works even when a policy is not matched yet.
      allow list: if hasPermission("claim.read")
                  || hasPermission("claim.createForCustomer")
                  || (signedIn() && resource.data.submitterUid == request.auth.uid);
      allow get: if hasPermission("claim.read")
                 || hasPermission("claim.createForCustomer")
                 || (signedIn() && resource.data.submitterUid == request.auth.uid)
                 || (resource.data.customerId != "" && ownsCustomer(resource.data.customerId));
      allow create: if medicalRequestCreateValid();
      allow update: if medicalReviewUpdateValid(requestId);
      allow delete: if false;
    }

    // Append-only follow-up evidence; never lets a submitter change a decision or amount.
    match /medicalClaimResponses/{responseId} {
      allow read: if hasPermission("claim.read")
                  || hasPermission("claim.createForCustomer")
                  || (
                    signedIn()
                    && resource.data.submitterUid == request.auth.uid
                    && exists(/databases/$(database)/documents/medicalClaimRequests/$(resource.data.requestId))
                    && (
                      (
                        get(/databases/$(database)/documents/medicalClaimRequests/$(resource.data.requestId)).data.submitterRole == "customer"
                        && ownsCustomer(get(/databases/$(database)/documents/medicalClaimRequests/$(resource.data.requestId)).data.customerId)
                      )
                      || isApprovedMedicalProvider()
                    )
                  );
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(["requestId","submitterUid","message","createdAt"])
                    && request.resource.data.keys().hasAll(["requestId","submitterUid","message","createdAt"])
                    && request.resource.data.submitterUid == request.auth.uid
                    && request.resource.data.requestId is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 2
                    && request.resource.data.message.size() <= 1500
                    && request.resource.data.createdAt == request.time
                    && exists(/databases/$(database)/documents/medicalClaimRequests/$(request.resource.data.requestId))
                    && get(/databases/$(database)/documents/medicalClaimRequests/$(request.resource.data.requestId)).data.submitterUid == request.auth.uid
                    && get(/databases/$(database)/documents/medicalClaimRequests/$(request.resource.data.requestId)).data.status == "needs_info"
                    && (
                      (
                        get(/databases/$(database)/documents/medicalClaimRequests/$(request.resource.data.requestId)).data.submitterRole == "customer"
                        && ownsCustomer(get(/databases/$(database)/documents/medicalClaimRequests/$(request.resource.data.requestId)).data.customerId)
                      )
                      || (
                        get(/databases/$(database)/documents/medicalClaimRequests/$(request.resource.data.requestId)).data.submitterRole == "provider"
                        && isApprovedMedicalProvider()
                      )
                    );
      allow update, delete: if false;
    }

    match /walkIns/{walkInId} {
      allow read: if hasPermission("walkin.read");
      allow create: if hasPermission("walkin.create")
                    && request.resource.data.status == "waiting";
      allow update: if hasPermission("walkin.manage");
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if hasPermission("customer.read") || ownsCustomer(customerId);
      allow create: if hasPermission("customer.create") || canCreateOwnCustomerRecord(customerId);
      allow update: if hasPermission("customer.update");
      allow delete: if false;
    }

    match /quotes/{quoteId} {
      allow read: if hasPermission("quote.read");
      allow create: if hasPermission("quote.create");
      allow update: if hasPermission("quote.update")
                    || hasPermission("quote.submit")
                    || hasPermission("underwriting.review");
      allow delete: if false;
    }

    match /policies/{policyId} {
      allow read: if hasPermission("policy.read") || hasPermission("billing.read") || hasPermission("finance.read") || ownsCustomer(resource.data.customerId);
      allow create: if hasPermission("policy.issue");
      allow update: if hasPermission("policy.update") || hasPermission("policy.endorse") || hasPermission("policy.renew") || hasPermission("policy.cancel")
        || (
          hasPermission("billing.manage")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "billingStatus","lastPaymentAmount","lastPaymentAt","billingUpdatedBy","updatedAt"
          ])
        );
      allow delete: if hasPermission("policy.delete") && resource.data.status != "active";
    }

    match /insuredAssets/{assetId} {
      allow read: if hasPermission("policy.read") || hasPermission("customer.read");
      allow create, update: if hasPermission("asset.manage") || hasPermission("policy.update");
      allow delete: if hasPermission("policy.delete");
    }

    match /claims/{claimId} {
      allow read: if hasPermission("claim.read") || ownsCustomer(resource.data.customerId);
      allow create: if hasPermission("claim.createForCustomer");
      allow update: if hasPermission("claim.update") || hasPermission("claim.assign") || hasPermission("claim.reserve") || hasPermission("claim.decide") || hasPermission("claim.settle") || hasPermission("claim.close") || hasPermission("claim.reopen") || hasPermission("approval.manage");
      allow delete: if false;
    }

    match /claimEvents/{eventId} {
      allow read: if hasPermission("claim.read");
      allow create: if hasPermission("claim.createForCustomer") || hasPermission("claim.update") || hasPermission("claim.reserve") || hasPermission("claim.decide") || hasPermission("claim.settle") || hasPermission("claim.close");
      allow update, delete: if false;
    }

    match /claimEvidence/{evidenceId} {
      allow read: if hasPermission("claim.read") || hasPermission("siu.read");
      allow create, update: if hasPermission("claim.evidence") || hasPermission("siu.manage");
      allow delete: if false;
    }

    match /siuCases/{caseId} {
      allow read: if hasPermission("siu.read");
      allow create: if hasPermission("siu.refer") || hasPermission("siu.manage");
      allow update: if hasPermission("siu.manage");
      allow delete: if false;
    }


    match /siuIndicators/{indicatorId} {
      allow read: if hasPermission("siu.read");
      allow create, update: if hasPermission("siu.manage");
      allow delete: if false;
    }

    match /siuEvidence/{evidenceId} {
      allow read: if hasPermission("siu.read");
      allow create: if hasPermission("siu.evidence");
      allow update: if hasPermission("siu.evidence") || hasPermission("siu.manage");
      allow delete: if false;
    }

    match /siuActions/{actionId} {
      allow read: if hasPermission("siu.read");
      allow create: if hasPermission("siu.manage") || hasPermission("siu.assign") || hasPermission("siu.evidence") || hasPermission("siu.finding");
      allow update, delete: if false;
    }

    match /siuFindings/{findingId} {
      allow read: if hasPermission("siu.read") || hasPermission("claim.read");
      allow create: if hasPermission("siu.finding");
      allow update: if hasPermission("siu.supervise");
      allow delete: if false;
    }

    match /billingTransactions/{transactionId} {
      allow read: if hasPermission("billing.read") || hasPermission("finance.read") || ownsCustomer(resource.data.customerId);
      allow create: if hasPermission("billing.manage") || hasPermission("approval.manage");
      allow update: if hasPermission("billing.manage");
      allow delete: if false;
    }




    match /billingPaymentAllocations/{allocationId} {
      allow read: if hasPermission("billing.read") || hasPermission("finance.read");
      allow create: if hasPermission("billing.manage");
      allow update, delete: if false;
    }

    match /billingCredits/{creditId} {
      allow read: if hasPermission("billing.read") || hasPermission("finance.read") || ownsCustomer(resource.data.customerId);
      allow create, update: if hasPermission("billing.manage");
      allow delete: if false;
    }

    match /billingInvoices/{invoiceId} {
      allow read: if hasPermission("billing.read") || hasPermission("finance.read") || ownsCustomer(resource.data.customerId);
      allow create, update: if hasPermission("billing.manage");
      allow delete: if false;
    }

    match /paymentPlans/{planId} {
      allow read: if hasPermission("billing.read") || hasPermission("finance.read") || ownsCustomer(resource.data.customerId);
      allow create, update: if hasPermission("billing.manage");
      allow delete: if false;
    }

    match /billingEvents/{eventId} {
      allow read: if hasPermission("billing.read") || hasPermission("finance.read");
      allow create: if hasPermission("billing.manage");
      allow update, delete: if false;
    }

    match /policyCancellations/{cancellationId} {
      allow read: if hasPermission("policy.read") || hasPermission("billing.read") || ownsCustomer(resource.data.customerId);
      allow create: if hasPermission("policy.update") || hasPermission("billing.manage");
      allow update: if hasPermission("policy.update") || hasPermission("billing.manage");
      allow delete: if false;
    }

    match /claimContacts/{contactId} {
      allow read: if hasPermission("claim.read");
      allow create: if hasPermission("claim.update") || hasPermission("claim.assign");
      allow update, delete: if false;
    }

    match /claimEstimates/{estimateId} {
      allow read: if hasPermission("claim.read");
      allow create, update: if hasPermission("claim.update") || hasPermission("claim.reserve");
      allow delete: if false;
    }

    match /companyLedger/{entryId} {
      allow read: if hasPermission("finance.read");
      allow create, update: if hasPermission("finance.manage");
      allow delete: if false;
    }

    match /documents/{documentId} {
      allow read: if hasPermission("document.read") || hasPermission("policy.read") || ownsCustomer(resource.data.customerId);
      allow create: if hasPermission("document.manage");
      allow update: if hasPermission("document.manage")
                    || (
                      ownsCustomer(resource.data.customerId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "acknowledged","acknowledgedAt","acknowledgedBy"
                      ])
                    );
      allow delete: if false;
    }




    match /customerHolds/{holdId} {
      allow read: if hasPermission("customer.read");
      allow create, update: if hasPermission("customer.hold.manage");
      allow delete: if false;
    }

    match /documentRequests/{requestId} {
      allow read: if hasPermission("document.read")
                  || hasPermission("document.request.manage")
                  || ownsCustomer(resource.data.customerId);
      allow create: if hasPermission("document.request.manage");
      allow update: if hasPermission("document.request.manage")
                    || (
                      ownsCustomer(resource.data.customerId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        "status","submittedAt","submittedBy"
                      ])
                      && request.resource.data.status == "submitted"
                    );
      allow delete: if false;
    }

    match /billingCreditApplications/{applicationId} {
      allow read: if hasPermission("billing.read") || hasPermission("finance.read");
      allow create: if hasPermission("billing.manage");
      allow update, delete: if false;
    }

    match /claimRecoveries/{recoveryId} {
      allow read: if hasPermission("claim.read") || hasPermission("finance.read");
      allow create, update: if hasPermission("claim.recovery");
      allow delete: if false;
    }

    match /customerCommunications/{communicationId} {
      allow read: if hasPermission("customer.read");
      allow create: if hasPermission("customer.communication");
      allow update, delete: if false;
    }

    match /claimParties/{partyId} {
      allow read: if hasPermission("claim.read");
      allow create, update: if hasPermission("claim.update");
      allow delete: if false;
    }

    match /claimCoverages/{coverageId} {
      allow read: if hasPermission("claim.read") || ownsCustomer(resource.data.customerId);
      allow create, update: if hasPermission("claim.decide") || hasPermission("claim.update");
      allow delete: if false;
    }

    match /policyTransactions/{transactionId} {
      allow read: if hasPermission("policy.read");
      allow create: if hasPermission("policy.update") || hasPermission("policy.endorse") || hasPermission("policy.renew") || hasPermission("policy.cancel");
      allow update, delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read: if hasPermission("appointment.read") || ownsCustomer(resource.data.customerId);
      allow create, update: if hasPermission("appointment.manage");
      allow delete: if false;
    }

    match /customerNotes/{noteId} {
      allow read: if hasPermission("customer.notes") || hasPermission("customer.read");
      allow create: if hasPermission("customer.notes");
      allow update, delete: if false;
    }

    match /customerActivity/{activityId} {
      allow read: if hasPermission("customer.read");
      allow create: if isActiveStaff();
      allow update, delete: if false;
    }

    match /serviceRequests/{requestId} {
      allow read: if hasPermission("serviceRequest.read")
                  || ownsCustomer(resource.data.customerId);
      allow create: if hasPermission("serviceRequest.manage")
                    || ownsCustomer(request.resource.data.customerId);
      allow update: if hasPermission("serviceRequest.manage");
      allow delete: if false;
    }

    match /policyVersions/{versionId} {
      allow read: if hasPermission("policy.read");
      allow create: if hasPermission("policy.issue") || hasPermission("policy.update") || hasPermission("policy.endorse") || hasPermission("policy.renew");
      allow update, delete: if false;
    }

    match /endorsements/{endorsementId} {
      allow read: if hasPermission("policy.read");
      allow create: if hasPermission("policy.endorse") || hasPermission("policy.update");
      allow update: if hasPermission("policy.endorse") || hasPermission("policy.update");
      allow delete: if false;
    }

    match /claimPayments/{paymentId} {
      allow read: if hasPermission("claim.read") || ownsCustomer(resource.data.customerId);
      allow create: if hasPermission("claim.payment");
      allow update: if hasPermission("claim.payment");
      allow delete: if false;
    }

    match /approvals/{approvalId} {
      allow read: if hasPermission("approval.read");
      allow create: if isActiveStaff();
      allow update: if hasPermission("approval.manage");
      allow delete: if false;
    }

    match /archives/{archiveId} {
      allow read: if hasPermission("archive.read");
      allow create, update: if hasPermission("archive.manage") || hasPermission("policy.update");
      allow delete: if hasPermission("archive.manage");
    }

    match /auditLogs/{logId} {
      allow read: if hasPermission("audit.read");
      allow create: if hasPermission("admin.manage")
                    || (
                      signedIn()
                      && !exists(bootstrapPath())
                      && logId == "bootstrap-000001"
                      && request.resource.data.sequence == 1
                      && request.resource.data.eventType == "system.bootstrap.completed"
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.actorEmployeeId == "SMI-000001"
                      && getAfter(bootstrapPath()).data.initialized == true
                      && getAfter(bootstrapPath()).data.initializedBy == request.auth.uid
                    );
      allow update, delete: if false;
    }

    // Phase 1 opt-in financial posting subsystem. Immutable operation and journal records.
    // For real payment processing, enforce balanced postings on a trusted backend.
    match /financialInvoices/{id} {
      allow read: if (hasPermission("billing.read") || hasPermission("finance.read"));
      allow create, update: if hasPermission("billing.manage");
      allow delete: if false;
    }
    match /financialJournals/{id} {
      allow read: if (hasPermission("billing.read") || hasPermission("finance.read"));
      allow create: if hasPermission("billing.manage")
        && request.resource.data.operationId == id
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.status == "posted";
      allow update, delete: if false;
    }
    match /financialOperations/{id} {
      allow read: if (hasPermission("billing.read") || hasPermission("finance.read"));
      allow create: if hasPermission("billing.manage")
        && request.resource.data.operationId == id
        && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /financialCustomerCredits/{id} {
      allow read: if (hasPermission("billing.read") || hasPermission("finance.read"));
      allow create, update: if hasPermission("billing.manage") && request.resource.data.customerId == id
        && request.resource.data.availableCents is int
        && request.resource.data.availableCents >= 0;
      allow delete: if false;
    }
    match /financialReversals/{id} {
      allow read: if (hasPermission("billing.read") || hasPermission("finance.read"));
      allow create: if hasPermission("billing.manage");
      allow update, delete: if false;
    }


    // Workflow requests are staff-authored, immutable except for terminal review decisions.
    match /workflowApprovals/{id} {
      allow read: if hasPermission("approval.read") || hasPermission("approval.manage");
      allow create: if isActiveStaff()
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.kind is string
        && request.resource.data.recordId is string
        && request.resource.data.summary is string
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 0;
      allow update: if (hasPermission("approval.manage"))
        && resource.data.status == "pending"
        && request.resource.data.status in ["approved", "rejected"]
        && request.resource.data.resolvedBy == request.auth.uid
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","resolvedBy","reason","resolvedAt","updatedAt"
        ]);
      allow delete: if false;
    }
    match /workflowTasks/{id} {
      allow read: if hasPermission("approval.read") || hasPermission("approval.manage");
      allow create: if isActiveStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == "open"
        && request.resource.data.approvalId == id;
      allow update: if (hasPermission("approval.manage"))
        && resource.data.status == "open"
        && request.resource.data.status == "completed"
        && request.resource.data.completedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status","completionResult","completedBy","completedAt","updatedAt"
        ]);
      allow delete: if false;
    }


    match /{document=**} { allow read, write: if false; }
  }
}
